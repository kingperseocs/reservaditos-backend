# Copy to .env.production on the server and fill in. Never commit .env.production.
# MONGODB_URI, PORT and NODE_ENV are set in docker-compose.prod.yml.

# Public URL of the API (used to build payment links), e.g. http://18.230.10.20
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP
APP_TIMEZONE=America/Lima
BUILDING_NAME=Edificio Demo
BUILDING_CODE=DEMO

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
