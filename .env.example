NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/reservaditos
PUBLIC_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Lima
BUILDING_NAME=Edificio Demo
BUILDING_CODE=DEMO

# AI provider for POST /v1/assistant/interpret: gemini | anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is overloaded (503) or out of free quota (429)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
